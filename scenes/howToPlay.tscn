[node name="Label7" type="Label" parent="VBoxContainer" unique_id=770287323]
layout_mode = 2
theme_override_fonts/font = ExtResource("1_uaj1o")
theme_override_font_sizes/font_size = 32
text = "​Welcome to Bounce Out!
You are a young spring chick encountering bouncy monsters as you travel.
Bounce is life, collect score using pinballs to damage your enemies!
​How to play:
Launch up balls into the arena
Bounce them using walls, bouncers, and flippers to increase your score
Gain upgrades and abilities to defeat harder monsters
A & D or left and right mouse buttons to control flippers
W & S or up and down arrow keys to change launch speed
F to use your ability

Space to launch!


"
horizontal_alignment = 1

[node name="Label5" type="Label" parent="VBoxContainer" unique_id=1713471044]
layout_mode = 2
theme_override_fonts/font = ExtResource("1_uaj1o")
theme_override_font_sizes/font_size = 32
text = "Tutorial
Bouncers, pegs, and flippers give points
Every 10 points you do 1 damage
After every boss you gain 1 upgrade/ability
You can hold as many upgrades as you like, but only 1 ability at a time   

"
horizontal_alignment = 1

